-- clipboard
local function getClip()
    if type(setclipboard) == "function" then return setclipboard end
    if type(syn) == "table" and type(syn.set_clipboard) == "function" then return syn.set_clipboard end
    if type(getgenv) == "function" then
        local g = getgenv()
        if type(g.setclipboard) == "function" then return g.setclipboard end
    end
    return nil
end

copyBtn.MouseButton1Click:Connect(function()
