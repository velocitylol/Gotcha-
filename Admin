-- watch incoming on every RemoteEvent
local function ser(v, d)
    d = d or 0
    if d > 3 then return "<d>" end
    local t = typeof(v)
    if t == "Instance" then return "<" .. v:GetFullName() .. ">" end
    if t == "string" then return string.format("%q", v) end
    if t == "table" then
        local p = {}
        for k, val in pairs(v) do p[#p+1] = tostring(k) .. "=" .. ser(val, d+1) end
        return "{" .. table.concat(p, ",") .. "}"
    end
    return tostring(v)
end

for _, r in ipairs(folder:GetChildren()) do
    if r:IsA("RemoteEvent") then
        r.OnClientEvent:Connect(function(...)
            local bits = {}
            for _, v in ipairs({...}) do bits[#bits+1] = ser(v) end
            add("<< " .. r.Name .. "(" .. table.concat(bits, ", ") .. ")",
                Color3.fromRGB(160, 255, 180))
        end)
    end
end

-- fire one target with chosen args
local argSets = {
    {}, {"x"}, {0}, {1}, {plr}, {plr.UserId}, {true},
}

local function makeFirer(name)
    return function()
        local r = folder:FindFirstChild(name)
        if not r then
            add(">> " .. name .. " MISSING", Color3.fromRGB(255, 120, 120))
            return
        end
        if r:IsA("RemoteFunction") then
            add(">> " .. name .. " (RF)", Color3.fromRGB(255, 220, 120))
            local ok, res = pcall(function() return r:InvokeServer() end)
            if ok then add("  -> " .. tostring(res), Color3.fromRGB(140, 255, 140))
            else add("  err " .. tostring(res), Color3.fromRGB(255, 120, 120)) end
            return
        end
        add(">> " .. name .. " (fire all shapes)", Color3.fromRGB(255, 220, 120))
        for i, args in ipairs(argSets) do
            local bits = {}
            for _, v in ipairs(args) do bits[#bits+1] = ser(v) end
            add("  [" .. i .. "] (" .. table.concat(bits, ", ") .. ")",
                Color3.fromRGB(150, 160, 220))
            pcall(r.FireServer, r, table.unpack(args))
        end
    end
end

