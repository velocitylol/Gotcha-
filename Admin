local function add(t, c)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.Text = tostring(t)
    l.TextColor3 = c or Color3.fromRGB(200, 200, 210)
    l.Font = Enum.Font.Code
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    l.LayoutOrder = #lines + 1
    l.Parent = log
    lines[#lines + 1] = tostring(t)
    print(t)
end

-- remote finder
local function fr(path, name)
    local node = RS
    for _, p in ipairs(path) do
        node = node:FindFirstChild(p)
        if not node then return nil end
    end
    return node:FindFirstChild(name)
end

