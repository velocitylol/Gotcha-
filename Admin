local cmds = {}
local old2
old2 = hookmetamethod(game, "__namecall", function(self, ...)
    local m = getnamecallmethod()
    if self == remote and m == "FireServer" then
        local a = {...}
        if not KEY and type(a[1]) == "string" and #a[1] > 20 then
            KEY = a[1]
            kl.Text = "key: " .. KEY
            kl.TextColor3 = Color3.fromRGB(140,255,140)
            add("KEY: " .. KEY, Color3.fromRGB(140,255,140))
        end
        if type(a[2]) == "string" and not cmds[a[2]] then
            cmds[a[2]] = true
            local e = ""
            if a[3] ~= nil then
                if type(a[3]) == "table" then
                    local p = {}
                    for k,v in pairs(a[3]) do p[#p+1] = k.."="..tostring(v) end
                    e = "  {"..table.concat(p,",").."}"
                else e = "  "..tostring(a[3]) end
            end
            add(">> "..a[2]..e, Color3.fromRGB(255,220,120))
        end
    end
    return old2(self, ...)
end)

local function fire(cmd, ...)
    if not KEY then add("no key", Color3.fromRGB(255,120,120)) return end
    pcall(function() remote:FireServer(KEY, cmd, ...) end)
end

local function nearest()
    local me = plr.Character
    if not me then return nil end
    local mp = me:GetPivot().Position
    local b, bd = nil, math.huge
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h then
                local dd = (h.Position - mp).Magnitude
                if dd < bd then b, bd = p.Character, dd end
            end
        end
    end
    return b
end

local function killOne()
    if not KEY then add("no key", Color3.fromRGB(255,120,120)) return end
    local c = nearest()
    if not c then add("no target", Color3.fromRGB(255,120,120)) return end
    local me = plr.Character
    if not me then return end
    add(">> kill "..c.Name, Color3.fromRGB(255,80,80))
    fire("Main_Damger_OC_R", c, {F=me, D=9999})
    fire("Main_Damger_OC_R", c, {F=me, D=999999})
    fire("Main_Damger_OC_R", c, {1=c, 2={F=me, D=999999}})
    fire("Main_Damger_OC_R", {c, {F=me, D=999999}})
    fire("Damage", c, 999999)
    fire("DealDamage", c, 999999)
    fire("Main_Damage", c, {F=me, D=999999})
    fire("Hit", c, {F=me, D=999999})
end

local function killAll()
    if not KEY then add("no key", Color3.fromRGB(255,120,120)) return end
    add("=== KILL ALL ===", Color3.fromRGB(255,80,80))
    local me = plr.Character
    if not me then return end
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= plr and p.Character then
            add("  "..p.Name, Color3.fromRGB(255,140,120))
            fire("Main_Damger_OC_R", p.Character, {F=me, D=999999})
        end
    end
end

local function dump()
    add("=== captured ===", Color3.fromRGB(255,220,120))
    for k in pairs(cmds) do add("  "..k, Color3.fromRGB(200,200,220)) end
end

