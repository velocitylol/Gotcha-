local dragging, dragStart, startPos
title.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos = fr.Position
    end
end)
title.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
        local v = i.Position - dragStart
        fr.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + v.X,
                                startPos.Y.Scale, startPos.Y.Offset + v.Y)
    end
end)
title.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local capturedCmds = {}
local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    local m = getnamecallmethod()
    if self == remote and m == "FireServer" then
        local a = {...}
        if not KEY and type(a[1]) == "string" and #a[1] > 20 then
            KEY = a[1]
            keyLabel.Text = "key: " .. KEY
            keyLabel.TextColor3 = Color3.fromRGB(140, 255, 140)
            add("KEY CAPTURED: " .. KEY, Color3.fromRGB(140, 255, 140))
        end
        if type(a[2]) == "string" and not capturedCmds[a[2]] then
            capturedCmds[a[2]] = true
            local extra = ""
            if a[3] ~= nil then
                if type(a[3]) == "table" then
                    local p = {}
                    for k, val in pairs(a[3]) do p[#p+1] = tostring(k) .. "=" .. tostring(val) end
                    extra = "  {" .. table.concat(p, ",") .. "}"
                else
                    extra = "  " .. tostring(a[3])
                end
            end
            add(">> " .. a[2] .. extra, Color3.fromRGB(255, 220, 120))
        end
    end
    return old(self, ...)
end)

local function fire(cmd, ...)
    if not KEY then add("no key yet", Color3.fromRGB(255, 120, 120)) return end
    pcall(function() remote:FireServer(KEY, cmd, ...) end)
end

local function nearestTarget()
    local me = plr.Character
    if not me then return nil end
    local myPos = me:GetPivot().Position
    local best, bestDist = nil, math.huge
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= plr and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myPos).Magnitude
                if d < bestDist then
                    best, bestDist = p.Character, d
                end
            end
        end
    end
    return best
end

local function killOne()
    if not KEY then add("no key yet", Color3.fromRGB(255, 120, 120)) return end
    local char = nearestTarget()
    if not char then add("no target", Color3.fromRGB(255, 120, 120)) return end
    local me = plr.Character
    if not me then return end
    add(">> kill " .. char.Name, Color3.fromRGB(255, 80, 80))
    fire("Main_Damger_OC_R", char, {F = me, D = 9999})
    fire("Main_Damger_OC_R", char, {F = me, D = 999999})
    fire("Main_Damger_OC_R", char, {1 = char, 2 = {F = me, D = 999999}})
    fire("Main_Damger_OC_R", {char, {F = me, D = 999999}})
    fire("Damage", char, 999999)
    fire("DealDamage", char, 999999)
    fire("Main_Damage", char, {F = me, D = 999999})
    fire("Hit", char, {F = me, D = 999999})
end

local function killAll()
    if not KEY then add("no key yet", Color3.fromRGB(255, 120, 120)) return end
    add("=== KILL ALL ===", Color3.fromRGB(255, 80, 80))
    local me = plr.Character
    if not me then return end
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= plr and p.Character then
            add("  " .. p.Name, Color3.fromRGB(255, 140, 120))
            fire("Main_Damger_OC_R", p.Character, {F = me, D = 999999})
        end
    end
end

local function spamDmg()
    if not KEY then add("no key yet", Color3.fromRGB(255, 120, 120)) return end
    local char = nearestTarget()
    if not char then return end
    local me = plr.Character
    if not me then return end
    add("=== SPAM " .. char.Name .. " ===", Color3.fromRGB(255, 80, 80))
    task.spawn(function()
        for i = 1, 60 do
            if not char.Parent then break end
            fire("Main_Damger_OC_R", char, {F = me, D = 999999})
            task.wait(0.03)
        end
    end)
end

