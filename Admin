local function copyTry(text)
    local fns = {setclipboard, toclipboard, function()
        return syn and syn.set_clipboard and syn.set_clipboard(text)
    end, function()
        return getgenv() and getgenv().setclipboard and getgenv().setclipboard(text)
    end}
    for i, f in ipairs(fns) do
        if type(f) == "function" then
            local ok = pcall(f, text)
            if ok then return i end
        end
    end
    return 0
end

